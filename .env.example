# Where "Book" buttons used to point (no longer used by the built-in booking)
NEXT_PUBLIC_BOOKING_URL=

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # secret! server only, never prefix with NEXT_PUBLIC

# "simulate" shows a fake QRIS with a "Simulate payment" button (testing only: anyone can then get free credits).
# Leave it empty or set "live" on the real website once a payment gateway is connected.
NEXT_PUBLIC_PAYMENT_MODE=simulate

# DOKU (QRIS). Dashboard -> Integration -> API Keys. Server only, never prefix with NEXT_PUBLIC.
# DOKU_ENV: "sandbox" while testing, "production" when live.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_ENV=sandbox

# Email (Resend). Dashboard -> API Keys. Server only.
RESEND_API_KEY=
# Studio address(es) that get every booking / purchase email, comma separated
NOTIFY_EMAIL_TO=
# Sender on a domain verified in Resend, e.g. Plot Twist Studio <hello@yourdomain.com>. Leave empty until the domain is verified:
# then only the studio is emailed. Once it is set, members get confirmations and reminders too.
EMAIL_FROM=
# Where replies from members go (e.g. your Gmail), optional
EMAIL_REPLY_TO=
# "off" stops emails to members
EMAIL_MEMBERS=

# WhatsApp (Fonnte), optional, switches on when FONNTE_TOKEN is set. Dashboard -> Device -> token. Server only.
FONNTE_TOKEN=
# Studio number(s) or group id(s) that get every booking / purchase message, comma separated (628123456789 or 12036...@g.us)
WA_NOTIFY_TO=
# "off" stops messages to members (the studio still gets its own)
WA_MEMBER_MESSAGES=
# Any long random text. The external scheduler (cron-job.org) sends it to /api/cron/reminders every 15 minutes (24-hour class reminders)
CRON_SECRET=

# Who can open /admin (comma separated emails of accounts that already exist)
ADMIN_EMAILS=you@example.com

# The website address (used for link previews and the sitemap). Set it in Vercel too.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
